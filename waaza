    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(1,0)
    Corner.Parent = Ripple

    TweenService:Create(
        Ripple,
        TweenInfo.new(.45,Enum.EasingStyle.Quint),

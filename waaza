    Progress.AnchorPoint = Vector2.new(0,1)
    Progress.Position = UDim2.new(0,0,1,0)
    Progress.Size = UDim2.new(1,0,0,3)
    Progress.BackgroundColor3 = Theme.Accent
    Progress.BorderSizePixel = 0
    Progress.Parent = Notification

    --------------------------------------------
    -- INTRO ANIMATION
    --------------------------------------------

    Notification.Position = UDim2.new(1,120,0,0)

    TweenService:Create(
        Notification,
        TweenInfo.new(.35, Enum.EasingStyle.Quint),
        {
            Position = UDim2.new(0,0,0,0)
        }
    ):Play()

    --------------------------------------------
    -- TIMER
    --------------------------------------------

    TweenService:Create(
        Progress,
        TweenInfo.new(Duration, Enum.EasingStyle.Linear),
        {
            Size = UDim2.new(0,0,0,3)
        }
    ):Play()

    --------------------------------------------
    -- REMOVE
    --------------------------------------------

    task.delay(Duration,function()

        TweenService:Create(
            Notification,
            TweenInfo.new(.3, Enum.EasingStyle.Quint),
            {
                BackgroundTransparency = 1
            }
        ):Play()

        for _,v in pairs(Notification:GetDescendants()) do

            if v:IsA("TextLabel") then

                TweenService:Create(
                    v,
                    TweenInfo.new(.3),
                    {
                        TextTransparency = 1
                    }
                ):Play()

            end

            if v:IsA("Frame") then

                TweenService:Create(
                    v,
                    TweenInfo.new(.3),
                    {
                        BackgroundTransparency = 1
                    }
                ):Play()

            end

        end

        task.wait(.35)

        Notification:Destroy()

    end)

end

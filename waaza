-- TOGGLE WINDOW
------------------------------------------------

local function ToggleWindow(State)

    Opened = State

    if Opened then

        Main.Visible = true

        TweenService:Create(
            UIScale,
            TweenInfo.new(.22,Enum.EasingStyle.Quint),
            {
                Scale = 1
            }
        ):Play()

        TweenService:Create(
            Main,
            TweenInfo.new(.22),
            {
                BackgroundTransparency = 0
            }
        ):Play()

        for _,v in pairs(Main:GetDescendants()) do

            if v:IsA("TextLabel") then

                TweenService:Create(
                    v,
                    TweenInfo.new(.2),
                    {
                        TextTransparency = 0
                    }
                ):Play()

            end

            if v:IsA("TextButton") then

                TweenService:Create(
                    v,
                    TweenInfo.new(.2),
                    {
                        TextTransparency = 0
                    }
                ):Play()

            end

            if v:IsA("Frame") then

                TweenService:Create(
                    v,
                    TweenInfo.new(.2),
                    {
                        BackgroundTransparency = 0
                    }
                ):Play()

            end

        end

    else

        TweenService:Create(
            UIScale,
            TweenInfo.new(.22,Enum.EasingStyle.Quint),
            {
                Scale = .92
            }
        ):Play()

        TweenService:Create(
            Main,
            TweenInfo.new(.22),
            {
                BackgroundTransparency = 1
            }
        ):Play()

        for _,v in pairs(Main:GetDescendants()) do

            if v:IsA("TextLabel") then

                TweenService:Create(
                    v,
                    TweenInfo.new(.2),
                    {
                        TextTransparency = 1
                    }
                ):Play()

            end

            if v:IsA("TextButton") then

                TweenService:Create(
                    v,
                    TweenInfo.new(.2),
                    {
                        TextTransparency = 1
                    }
                ):Play()

            end

            if v:IsA("Frame") then

                TweenService:Create(
                    v,
                    TweenInfo.new(.2),
                    {
                        BackgroundTransparency = 1
                    }
                ):Play()

            end

        end

        task.delay(.22,function()

            if not Opened then
                Main.Visible = false
            end

        end)

    end

end


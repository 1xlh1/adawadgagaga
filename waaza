local function RefreshSections()

    for _,Tab in pairs(Window.Tabs) do

        for _,Section in pairs(Tab.Sections) do

            local VisibleCount = 0

            for _,Element in pairs(Section.Elements) do

                if Element.Object.Visible then
                    VisibleCount += Element.Object.Size.Y.Offset + 10
                end

            end

           Section.Holder.Size = UDim2.new(
    1,
    -24,
    0,
    VisibleCount
)

SectionFrame.Visible = VisibleCount > 0

        end

    end

end


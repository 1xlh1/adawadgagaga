            local Percent = math.clamp(
                (input.Position.X - Bar.AbsolutePosition.X)
                / Bar.AbsoluteSize.X,
                0,
                1
            )

            SetValue(
                Min + ((Max - Min) * Percent)
            )

        end

    end)

    UserInputService.InputEnded:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = false
        end

    end)


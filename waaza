local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Library = {}
Library.__index = Library
Library.ThemeObjects = {}

function Library:RegisterTheme(Object,Property,ColorKey)

    table.insert(Library.ThemeObjects,{
        Object = Object,
        Property = Property,
        ColorKey = ColorKey
    })

end

function Library:SetTheme(Name)

    local NewTheme = Themes[Name]

    if not NewTheme then
        return
    end

    Theme = NewTheme

    for _,Data in pairs(Library.ThemeObjects) do

        pcall(function()

            TweenService:Create(
                Data.Object,
                TweenInfo.new(.25),
                {
                    [Data.Property] = Theme[Data.ColorKey]
                }
            ):Play()

        end)

    end

end

